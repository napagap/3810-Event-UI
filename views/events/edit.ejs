<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit event - <%= event.eventCode %></title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: bold; }
        input, select { width: 100%; padding: 8px; box-sizing: border-box; max-width: 400px; }
        button { padding: 10px 15px; background-color: #28a745; color: white; border: none; cursor: pointer; }
        button:hover { background-color: #218838; }
        .cancel-btn { background-color: #6c757d; text-decoration: none; padding: 10px 15px; color: white; display: inline-block; margin-left: 10px;}
    </style>
</head>
<body>
    <h1>Edit event：<%= event.eventCode %></h1>

    <form action="/events/<%= event.eventCode %>/update" method="POST">
        
        <div class="form-group">
            <label>Name of the Event (Title):</label>
            <input type="text" name="title" value="<%= event.title %>" required>
        </div>

        <div class="form-group">
            <label>Category:</label>
            <select name="category" required>
                <% categories.forEach(function(cat) { %>
                    <option value="<%= cat %>" <%= event.category === cat ? 'selected' : '' %>><%= cat %></option>
                <% }); %>
            </select>
        </div>

        <div class="form-group">
            <label>Venue:</label>
            <input type="text" name="venue" value="<%= event.venue %>" required>
        </div>

        <div class="form-group">
            <label>Start At:</label>
            <% 
                let formattedDate = '';
                if (event.startAt) {
                    const d = new Date(event.startAt);
                    d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
                    formattedDate = d.toISOString().slice(0,16);
                }
            %>
            <input type="datetime-local" name="startAt" value="<%= formattedDate %>" required>
        </div>

        <div class="form-group">
            <label>Capacity:</label>
            <input type="number" name="capacity" value="<%= event.capacity %>" required min="1">
        </div>

        <div class="form-group">
            <label>Status:</label>
            <select name="status" required>
                <% statuses.forEach(function(stat) { %>
                    <option value="<%= stat %>" <%= event.status === stat ? 'selected' : '' %>><%= stat %></option>
                <% }); %>
            </select>
        </div>

        <button type="submit">Save Changes</button>
        <a href="/events" class="cancel-btn">Cancel</a>
    </form>
</body>
</html>